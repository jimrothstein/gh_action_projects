
name: 922_if_commit.yml

## PURPOSE:
#  check commit message, do or don't do based on message content
on:
  push:
    branch:
      dev
  workflow_dispatch:

run-name:  922 on ${{ github.event_name }}, branch is ${{ github.headref || github.ref_name }}, ${{ github.run_number }}, @${{ github.actor }}


jobs:

  build:
    name: build
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: echo
        run: |
          echo "build is now running"


# job runs only if event is workflow_dispatch
  workflow_job:
    name:  workflow_job_name
    runs-on:  ubuntu-latest
    if: ${{ github.event_name == 'workflow_dispatch' }}
    steps:
      - name: echo
        run: |
          echo "event must be workflow_dispatch"

# job runs only if event is push
  debug:
    name: Debug
    runs-on: ubuntu-latest
    if: ${{ github.event_name == 'push' }}
    steps:
      - name: echo
        run: echo "event is ${{ github.event_name }};  branch is ${{ github.ref_name }}"

      - name: Print environment variables
        run: env

      - name: Print events.json
        run: cat "$GITHUB_EVENT_PATH"

      - name: Dump GitHub context
        env:
          GITHUB_CONTEXT: ${{ toJson(github) }}
        run: echo "$GITHUB_CONTEXT"

      - name: Dump job context
        env:
          JOB_CONTEXT: ${{ toJson(job) }}
        run: echo "$JOB_CONTEXT"


# Runs, based on message content

  check_commit:
    name: check
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: echo
        run: |
          echo "check_templates is running ..."

      - name: message
        run: |
          echo "commit message is ${{github.event.commits[0].message}}"  >> $GITHUB_STEP_SUMMARY

# Commit message MUST contain [skip], including the brackets
      - name: skip
        if: >
          !contains(github.event.commits[0].message, '[skip]')
        run: |
          echo "Does not contain `[skip]`"


